# ---------- Server-only (Vercel env vars / local .env) — NEVER prefix with VITE_ ----------
# Comma-separated lists: the first key is tried first; on 429/quota/5xx/timeout we move to the next.
GEMINI_API_KEYS=
# Optional model fallback list (default: gemini-flash-latest,gemini-flash-lite-latest,gemini-3.5-flash)
GEMINI_MODELS=
GROQ_API_KEYS=
# Optional (default: openai/gpt-oss-120b,llama-3.3-70b-versatile)
GROQ_MODELS=
# Optional third provider — any OpenAI-compatible API (e.g. Cerebras: https://api.cerebras.ai/v1, freellmapi, OpenRouter…)
EXTRA_PROVIDER_NAME=
EXTRA_PROVIDER_BASE_URL=
EXTRA_PROVIDER_API_KEYS=
EXTRA_PROVIDER_MODELS=
EXTRA_PROVIDER_JSON_MODE=
# Per-attempt timeout in ms (default 25000; total per request is capped at ~52s for Vercel)
AI_TIMEOUT_MS=
# CORS for /api/ai — comma-separated origins allowed to call it (default *). e.g. https://your-app.lovable.app
ALLOWED_ORIGINS=

# ---------- Client (public) — Firebase web config ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------- Optional: API location when the frontend is hosted separately (e.g. Lovable) ----------
# Leave empty on Vercel. Example: https://studyduel.vercel.app
VITE_API_BASE_URL=

# ---------- Optional: use local Firebase emulators instead of a real project (true/false) ----------
VITE_FIREBASE_EMULATORS=

# ---------- Optional TURN servers for voice calls (comma-separated URLs) ----------
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
